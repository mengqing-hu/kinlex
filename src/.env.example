# Usage:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in the values below
# 3. Never commit .env (it is listed in .gitignore)

# ScaDS.AI model service (OpenAI-compatible LLM and TTS API)
SCADS_API_URL=
SCADS_API_KEY=

# Postgres connection used to read vocabulary and write enrichment
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Cloudflare R2 (audio upload). Leave empty locally to write audio into
# web/public/audio-samples instead of uploading it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional YouTube sign-in for kinlex-video, needed for age-restricted videos: the browser whose
# cookies yt-dlp reads (chrome, firefox, safari, edge, brave), or a cookies.txt exported from it.
YOUTUBE_COOKIES_FROM_BROWSER=
YOUTUBE_COOKIES_FILE=

# Optional website cache refresh after a successful run
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# Production content. Run a command with KINLEX_TARGET=production to work on the production
# database instead; it then also reads .env.production (git-ignored), whose values replace these.
# That file holds three values:
#   DATABASE_URL: the session pooler connection string from the Supabase dashboard (Connect ->
#     Session pooler), with the password percent-encoded
#   WEB_REVALIDATE_URL=https://kinlex.vercel.app/api/revalidate
#   REVALIDATE_SECRET: the REVALIDATE_SECRET of the Vercel project
