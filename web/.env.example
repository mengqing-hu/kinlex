# Usage:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Run `supabase status` from the repository root.
# 3. Copy the local Publishable key into NEXT_PUBLIC_SUPABASE_ANON_KEY.
# 4. Never commit .env.local.

# Public Supabase connection values. Access must still be protected by row level security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local audio samples and the canonical site URL used for absolute links and metadata.
NEXT_PUBLIC_AUDIO_BASE_URL=/audio-samples
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated feature flags in name=on|off format.
FEATURE_FLAGS=grammar=off

# Shared only with the publishing pipeline for authenticated cache revalidation.
# Generate a local value with: openssl rand -hex 32
REVALIDATE_SECRET=
